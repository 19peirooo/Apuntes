package abstractfactorymethod.enemy;

public class W1Daemon implements Daemon{
	
	private String name;
	private Integer power;
	private Integer lives;
	private String color;
	
	
	
	public W1Daemon() {
		this.name = "W1Daemon";
		this.power = 10 * World.World1.getComplexFactor();
		this.lives = 1 * World.World1.getComplexFactor();
		this.color = "Rojo";
	}

	@Override
	public String getName() {
		return this.name;
	}

	@Override
	public Integer getPower() {
		return this.power;
	}

	@Override
	public Integer getLives() {
		return null;
	}

	@Override
	public String getColor() {
		// TODO Auto-generated method stub
		return null;
	}

}
