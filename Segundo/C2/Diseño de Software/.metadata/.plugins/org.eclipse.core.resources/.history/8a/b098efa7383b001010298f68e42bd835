package observerpattern.bases;

import java.util.ArrayList;
import java.util.List;

public class ObservableNumber implements PullPushObservable {
	
	private List<PullPushObserver> observers; //El observable guarda los observadores a los que notificar
	private Integer number; //Estado a observar
	
	public ObservableNumber(Integer number) {
		this(number, new ArrayList<PullPushObserver>());
	}
	
	public ObservableNumber(Integer number, List<PullPushObserver> observers) {
		this.number = number;
		this.observers = observers;
	}
	
	public Integer getNumber() {
		return this.number;
	}

	public void setNumber(Integer number) { //Se notifica del cambio de estado con el setter
		this.number = number;
		this.notifyObservers();
	}

	@Override
	public void attach(PullPushObserver observer) { //Se añade un observador a la lista
		this.observers.add(observer);
	}

	@Override
	public void detach(PullPushObserver observer) { //Se elimina un observador de la lista
		this.observers.remove(observer);
	}

	@Override
	public void notifyObservers() {
		for (PullPushObserver observer : this.observers) {
			observer.update(this, this.number);
		}
		
	}
}
